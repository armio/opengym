{
  "name": "opengym-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --local-upstream localhost:8787 --upstream-protocol http",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "db:migrate:local": "wrangler d1 migrations apply opengym-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply opengym-db --remote"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.1",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.24.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260930.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.145.0"
  }
}
