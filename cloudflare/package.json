{
  "name": "opengym-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply opengym-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply opengym-db --remote",
    "db:seed:local": "wrangler d1 execute opengym-db --local --file=seed/exercises.sql",
    "db:seed:remote": "wrangler d1 execute opengym-db --remote --file=seed/exercises.sql"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.24.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260930.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.145.0"
  }
}
